<Window x:Class="PawsPatchLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PawsPatchLauncher"
        Title="Paw's Patch Launcher" Width="1440" Height="900" MinWidth="1050" MinHeight="680"
        FontFamily="Arial" Icon="Assets/PawsPatch.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource NightBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#07101F" Offset="0"/>
            <GradientStop Color="#0A1930" Offset="0.52"/>
            <GradientStop Color="#07101F" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#B2132541"/>
            <Setter Property="BorderBrush" Value="#3D5473"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="FieldTitle" TargetType="TextBlock" BasedOn="{StaticResource CardSubtitle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MetadataText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SmallMetadataText" TargetType="TextBlock" BasedOn="{StaticResource MetadataText}">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ConfigurationInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0A1729"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="#405878"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="5"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                local:Motion.Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="local:Motion.BorderBrush" Value="#7892B3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="local:Motion.Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1B304D"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="#60738D"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#162A45"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="ReleaseCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" local:Motion.Background="#1B304D" local:Motion.BorderBrush="#60738D" BorderThickness="1" CornerRadius="4" Padding="9,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="▾" HorizontalAlignment="Right" Foreground="{StaticResource GoldBrightBrush}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="local:Motion.Background" Value="#304867"/>
                                                <Setter TargetName="ComboBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#162A45" BorderBrush="#60738D" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background" Value="#1B304D"/>
            <Setter Property="BorderBrush" Value="#526984"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder" local:Motion.Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter local:Motion.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="local:Motion.Background" Value="#4A3C20"/>
                                <Setter TargetName="ModeBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModeBorder" Property="local:Motion.Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PatchChannelChoice" TargetType="RadioButton" BasedOn="{StaticResource ModeRadio}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#594A2A" BorderThickness="1" Background="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="#B00A1425">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="P A W ' S   P A T C H" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GoldBrightBrush}"/>
                    <TextBlock Text="  /  KOHAN II" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel x:Name="TitleActions" Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="LauncherUpdateButton" Visibility="Collapsed" Height="32" Margin="0,7,12,7" Style="{StaticResource GoldButton}" Padding="12,4" Click="LauncherUpdateButton_Click"/>
                    <TextBlock x:Name="PatchChannelLabel" Style="{StaticResource MetadataText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="HeaderReleaseRadio" GroupName="HeaderPatchChannel" Tag="stable" Style="{StaticResource PatchChannelChoice}" Checked="PatchChannel_Checked"/>
                    <RadioButton x:Name="HeaderBetaRadio" GroupName="HeaderPatchChannel" Tag="beta" Style="{StaticResource PatchChannelChoice}" Margin="4,0,14,0" Checked="PatchChannel_Checked"/>
                    <Button x:Name="LanguageButton" Width="58" Height="32" Margin="0,7,6,7" Style="{StaticResource GhostButton}" Padding="4" Click="LanguageButton_Click">EN</Button>
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource TitleButton}" Width="42" Height="46" Click="MinimizeButton_Click"><local:LauncherIcon Kind="Minimize"/></Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource TitleButton}" local:Motion.HoverBackground="#753B43" local:Motion.PressedBackground="#512730" Width="46" Height="46" Click="CloseButton_Click"><local:LauncherIcon Kind="Close"/></Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="MainBody" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#A90A1528" BorderBrush="#344967" BorderThickness="0,0,1,0">
                    <Grid Margin="18,26,18,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="BrandMark" Source="{StaticResource PawAppMark}" Width="108" Height="108" HorizontalAlignment="Center"
                               AutomationProperties.Name="Paw's Patch"/>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="HomeNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="HomeNav_Click"/>
                            <Button x:Name="ModulesNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="ModulesNav_Click"/>
                            <Button x:Name="MultiplayerNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="MultiplayerNav_Click"/>
                            <Button x:Name="SettingsNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="SettingsNav_Click"/>
                            <Button x:Name="AboutNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="AboutNav_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4">
                            <TextBlock x:Name="LauncherVersionLabel" Style="{StaticResource SmallMetadataText}" Foreground="#708098"/>
                            <TextBlock x:Name="LauncherVersionText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="30,24,30,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="29"/>
                            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border x:Name="ReadyStatusBadge" Grid.Column="1" CornerRadius="14" Background="#193926" BorderBrush="#3F8D64" BorderThickness="1" Padding="14,6" VerticalAlignment="Center" MaxWidth="270" Margin="12,0,0,0">
                            <TextBlock x:Name="ReadyStatusText" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="MainOptionsScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel x:Name="AboutPatchPanel" Visibility="Collapsed">
                                    <Border x:Name="AboutIntroCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock x:Name="AboutTitleText" Style="{StaticResource CardTitle}"/>
                                            <TextBlock x:Name="AboutIntroText" Style="{StaticResource CardDescription}" Margin="0,0,0,14"/>
                                            <WrapPanel x:Name="AboutTabsPanel" Margin="0,0,0,6">
                                                <Button x:Name="AboutAlwaysTab" Tag="always" Style="{StaticResource GhostButton}" Padding="14,6" Margin="0,0,8,8" Click="AboutCategory_Click"/>
                                                <Button x:Name="AboutOptionalTab" Tag="optional" Style="{StaticResource GhostButton}" Padding="14,6" Margin="0,0,8,8" Click="AboutCategory_Click"/>
                                                <Button x:Name="AboutBetaTab" Tag="beta" Style="{StaticResource GhostButton}" Padding="14,6" Margin="0,0,0,8" Click="AboutCategory_Click"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="AboutCategoryText" Style="{StaticResource CardDescription}"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="AboutEntriesPanel"/>
                                </StackPanel>
                                <Border x:Name="SettingsPanel" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="SettingsTitleText" Style="{StaticResource CardTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="SettingsLanguageTitleText" Style="{StaticResource FieldTitle}"/>
                                                <TextBlock x:Name="SettingsLanguageDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,12,0"/>
                                            </StackPanel>
                                            <Button x:Name="SettingsLanguageButton" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="14,7" Click="LanguageButton_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="LauncherUpdatesDescriptionText" Style="{StaticResource CardDescription}" Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PatchUpdatesCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="PatchUpdatesTitleText" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="PatchChannelDescriptionText" Style="{StaticResource CardDescription}" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="SettingsReleaseRadio" GroupName="SettingsPatchChannel" Tag="stable" Style="{StaticResource PatchChannelChoice}" Checked="PatchChannel_Checked"/>
                                            <RadioButton x:Name="SettingsBetaRadio" GroupName="SettingsPatchChannel" Tag="beta" Style="{StaticResource PatchChannelChoice}" Margin="6,0,0,0" Checked="PatchChannel_Checked"/>
                                        </StackPanel>
                                        <Separator Margin="0,16,0,13" Background="#40536E"/>
                                        <TextBlock x:Name="SettingsRepairTitleText" Style="{StaticResource FieldTitle}"/>
                                        <TextBlock x:Name="SettingsRepairDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                        <Button x:Name="SettingsRepairButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,11,0,0" Padding="14,7" Click="RepairButton_Click"/>
                                        <Separator Margin="0,16,0,13" Background="#40536E"/>
                                        <TextBlock x:Name="SettingsUpdatesDescriptionText" Style="{StaticResource CardDescription}"/>
                                        <TextBlock x:Name="LastCheckedText" Style="{StaticResource SmallMetadataText}" Foreground="#71819A" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ConfigurationCodeCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock x:Name="ConfigurationTitleText" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource HelpButton}" Tag="configuration" Margin="8,0,0,0" VerticalAlignment="Center" Click="HelpButton_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ConfigurationDescriptionText" Style="{StaticResource CardDescription}"/>
                                        <Border Background="#0A1729" BorderBrush="#405878" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,10,0,9">
                                            <TextBlock x:Name="ConfigurationCodeText" Foreground="{StaticResource GoldBrightBrush}" TextWrapping="Wrap"/>
                                        </Border>
                                        <Button x:Name="CopyConfigurationButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,7" Click="CopyConfigurationButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="ConfigurationImportHost" Visibility="Collapsed"/>
                                <StackPanel x:Name="ReliabilityPanels"/>
                                <Border x:Name="HomeWelcomeCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="HomeWelcomeTitleText" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="HomeWelcomeBodyText" Style="{StaticResource CardDescription}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="UpdateNoticeBorder" Style="{StaticResource Card}" BorderBrush="{StaticResource GoldBrush}" Background="#B23A321D" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="UpdateNoticeTitleText" Style="{StaticResource CardTitle}" Foreground="{StaticResource GoldBrightBrush}"/>
                                        <TextBlock x:Name="UpdateNoticeBodyText" Style="{StaticResource CardDescription}" Foreground="#E7DFC9"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="DiagnosticsCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock x:Name="DiagnosticsTitleText" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource HelpButton}" Tag="diagnostics" Margin="8,0,0,0" VerticalAlignment="Center" Click="HelpButton_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DiagnosticsDescriptionText" Style="{StaticResource CardDescription}"/>
                                        <WrapPanel Margin="0,11,0,0">
                                            <Button x:Name="DiagnosticsButton" Style="{StaticResource GhostButton}" Padding="14,7" Margin="0,0,8,8" Click="DiagnosticsButton_Click"/>
                                            <Button x:Name="ShowDiagnosticsArchiveButton" Style="{StaticResource GhostButton}" Padding="14,7" Margin="0,0,0,8" IsEnabled="False" Click="ShowDiagnosticsArchiveButton_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="DiagnosticsArchiveInfoText" Style="{StaticResource MetadataText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="GameInfoCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock x:Name="GamePathLabel" Style="{StaticResource CardTitle}"/>
                                                <TextBlock x:Name="GamePathText" TextTrimming="CharacterEllipsis" FontSize="14" Margin="0,0,16,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <WrapPanel Grid.Row="1" Margin="0,10,0,5">
                                            <Button x:Name="BrowseButton" Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,8" Click="BrowseButton_Click"/>
                                            <Button x:Name="OpenGameFolderButton" Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,0,8" Click="OpenGameFolderButton_Click"/>
                                        </WrapPanel>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="GameVersionLabel" Style="{StaticResource MetadataText}"/>
                                                <TextBlock x:Name="GameVersionText" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="PatchVersionLabel" Style="{StaticResource MetadataText}"/>
                                                <TextBlock x:Name="PatchVersionText" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="ModulesTitleText" Style="{StaticResource CardTitle}" Margin="2,0,0,10" Visibility="Collapsed"/>

                                <Border x:Name="MultiplayerNoteCard" CornerRadius="6" Background="#B238301D" BorderBrush="#8C7137" BorderThickness="1" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                                    <Grid x:Name="MultiplayerNoteContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <local:LauncherIcon Kind="Multiplayer" Foreground="{StaticResource GoldBrightBrush}" Margin="0,0,9,0"/>
                                        <TextBlock x:Name="MultiplayerNoteText" Style="{StaticResource CardDescription}" Grid.Column="1" Foreground="#E7DFC9" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="CoreModuleCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#24394B" BorderBrush="#566477" BorderThickness="1"><local:LauncherIcon Kind="Shield" Width="21" Height="21" Foreground="{StaticResource GoldBrightBrush}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="CoreTitleText" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.core" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CoreDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="RussianModuleCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#24394B" BorderBrush="#566477" BorderThickness="1"><local:LauncherIcon Kind="Language" Width="21" Height="21" Foreground="{StaticResource GoldBrightBrush}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="RussianTitleText" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.ru" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="RussianDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="RussianToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="ColorsModuleCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#24394B" BorderBrush="#566477" BorderThickness="1"><local:LauncherIcon Kind="Palette" Width="21" Height="21" Foreground="{StaticResource GoldBrightBrush}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="ColorsTitleText" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.colors" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ColorsDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ColorsToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="OosModuleCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#24394B" BorderBrush="#566477" BorderThickness="1"><local:LauncherIcon Kind="Sync" Width="21" Height="21" Foreground="{StaticResource GoldBrightBrush}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="OosTitleText" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.oos" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <RadioButton x:Name="OfficialOosRadio" GroupName="OosMode" Tag="official" Style="{StaticResource ModeRadio}" Checked="OosMode_Checked"/>
                                                <RadioButton x:Name="ContinueOosRadio" Grid.Column="2" GroupName="OosMode" Tag="continue" Style="{StaticResource ModeRadio}" Checked="OosMode_Checked"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="IndependentHostilityCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#24394B" BorderBrush="#566477" BorderThickness="1"><local:LauncherIcon Kind="Swords" Width="21" Height="21" Foreground="{StaticResource GoldBrightBrush}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="IndependentTitleText" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.independent" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="IndependentDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="IndependentHostilityToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="GameplayOptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="RoamingSpawnCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#24394B" BorderBrush="#566477" BorderThickness="1"><local:LauncherIcon Kind="Clock" Width="21" Height="21" Foreground="{StaticResource GoldBrightBrush}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="RoamingSpawnTitleText" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.spawn" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <RadioButton x:Name="StandardSpawnRadio" GroupName="SpawnMode" Tag="standard" Style="{StaticResource ModeRadio}" Checked="SpawnMode_Checked"/>
                                                <RadioButton x:Name="X4SpawnRadio" Grid.Column="2" GroupName="SpawnMode" Tag="x4" Style="{StaticResource ModeRadio}" Checked="SpawnMode_Checked"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="AdditionalRoamingCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#24394B" BorderBrush="#566477" BorderThickness="1"><local:LauncherIcon Kind="Route" Width="21" Height="21" Foreground="{StaticResource GoldBrightBrush}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="AdditionalRoamingTitleText" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.roaming" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AdditionalRoamingDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AdditionalRoamingToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="GameplayOptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="SiegeBalanceCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#24394B" BorderBrush="#566477" BorderThickness="1"><local:LauncherIcon Kind="Siege" Width="21" Height="21" Foreground="{StaticResource GoldBrightBrush}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SiegeBalanceTitleText" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.siege" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SiegeBalanceDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SiegeBalanceToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="GameplayOptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="PowersShardsCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#24394B" BorderBrush="#566477" BorderThickness="1"><local:LauncherIcon Kind="Components" Width="21" Height="21" Foreground="{StaticResource GoldBrightBrush}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <Grid HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="PowersShardsTitleText" Style="{StaticResource FieldTitle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <Button x:Name="PowersShardsHelpButton" Grid.Column="1" Style="{StaticResource HelpButton}" Tag="modules.powers" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="PowersShardsDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="PowersShardsToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="PowersShardsChanged" AutomationProperties.Name="Disable Powers and Shards"/>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="RecoveryHost" Visibility="Collapsed"/>
                                <Border x:Name="RemovalCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="RemovalTitleText" Style="{StaticResource CardTitle}" Foreground="#F2B6A9"/>
                                        <TextBlock x:Name="RemovePatchDescriptionText" Style="{StaticResource CardDescription}" Margin="0,0,0,8"/>
                                        <Button x:Name="RemovePatchButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,7" BorderBrush="#986A60" Click="RemovePatch_Click"/>
                                        <TextBlock x:Name="RemoveLauncherDescriptionText" Style="{StaticResource CardDescription}" Margin="0,17,0,8"/>
                                        <Button x:Name="RemoveLauncherButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,7" BorderBrush="#986A60" Click="RemoveLauncher_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="ToastPanel" Grid.Column="0" Panel.ZIndex="20" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="460" Margin="8,0,24,12" Padding="14,12"
                                Background="#172E47" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <local:LauncherIcon x:Name="ToastIcon" Kind="Check"/>
                                <TextBlock x:Name="ToastText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Margin="0,0,10,0"
                                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                                <Button x:Name="ToastCloseButton" Grid.Column="2" Style="{StaticResource TitleButton}"
                                        Padding="0" Width="26" Height="28" VerticalAlignment="Top" Click="ToastCloseButton_Click"><local:LauncherIcon Kind="Close" Width="16" Height="16"/></Button>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="NewsTitleText" Style="{StaticResource CardTitle}" Margin="0"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button x:Name="PatchChangelogButton" Style="{StaticResource GhostButton}" Tag="patch" Padding="14,6" Click="ChangelogTab_Click"/>
                                    <Button x:Name="LauncherChangelogButton" Style="{StaticResource GhostButton}" Tag="launcher" Padding="14,6" Margin="8,0,0,0" Click="ChangelogTab_Click"/>
                                </StackPanel>
                                <ScrollViewer x:Name="NewsScrollViewer" Grid.Row="4" ClipToBounds="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Padding="0,0,10,0">
                                    <StackPanel x:Name="NewsEntriesPanel"/>
                                </ScrollViewer>
                                <Border x:Name="OperationStatusPanel" Grid.Row="5" Margin="0,14,0,0" Padding="12,11"
                                        Background="#182D46" BorderBrush="#617C9D" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock x:Name="OperationText" Foreground="{StaticResource TextMainBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,10,0,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TransferText" Style="{StaticResource MetadataText}" Visibility="Collapsed" Margin="0,8,0,0"/>
                                        <Button x:Name="CancelDownloadButton" Visibility="Collapsed" Style="{StaticResource GhostButton}" Padding="9,5" Margin="0,9,0,0" Click="CancelDownload_Click"/>
                                        <StackPanel x:Name="ErrorActionsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                            <Button x:Name="ErrorActionButton" Style="{StaticResource GhostButton}" FontSize="12" Padding="8,6" Click="ErrorAction_Click"/>
                                            <Button x:Name="ErrorDetailsButton" Style="{StaticResource GhostButton}" FontSize="11" Padding="8,6" Margin="0,7,0,0" Click="ErrorDetails_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="UpdateButton" Style="{StaticResource GoldButton}" Click="UpdateButton_Click"/>
                        <Button x:Name="CheckUpdatesButton" Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="CheckUpdatesButton_Click"/>
                        <Button x:Name="LaunchButton" Grid.Column="3" Style="{StaticResource GoldButton}" Padding="30,11" Click="LaunchButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>

            <Border x:Name="HelpOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Background="#D907101F" Visibility="Collapsed">
                <Grid>
                    <Border Width="520" MaxWidth="520" Background="#132541" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="9" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#3B5375" BorderBrush="{StaticResource GoldBrightBrush}" BorderThickness="1" Margin="0,0,12,0">
                                    <local:LauncherIcon Kind="Help" Foreground="{StaticResource GoldBrightBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="HelpTitleText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="HelpBodyText" Foreground="#D5DDE8" FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,18,0,20"/>
                            <Button x:Name="HelpCloseButton" Style="{StaticResource GoldButton}" HorizontalAlignment="Right" Padding="22,9" Click="HelpCloseButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="ConfirmationOverlay" Grid.RowSpan="2" Panel.ZIndex="200" Background="#B807101F" Visibility="Collapsed"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
                    <Border x:Name="ConfirmationCard" MaxWidth="620" Background="#132541" BorderBrush="#AD8150" BorderThickness="1" CornerRadius="12" Padding="26"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12" Background="#432E35" BorderBrush="#87565A" BorderThickness="1" VerticalAlignment="Top">
                                    <local:LauncherIcon Kind="Trash" Width="23" Height="23" Foreground="#F3AA96"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ConfirmationEyebrowText" Style="{StaticResource MetadataText}" Foreground="{StaticResource GoldBrightBrush}" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="ConfirmationTitleText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ConfirmationCloseButton" Grid.Column="2" Style="{StaticResource TitleButton}" Width="30" Height="30" Padding="0" VerticalAlignment="Top" Click="ConfirmationCancel_Click"><local:LauncherIcon Kind="Close"/></Button>
                            </Grid>
                            <TextBlock x:Name="ConfirmationBodyText" Grid.Row="1" Foreground="#D5DDE8" FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,20,0,18"/>
                            <Border Grid.Row="2" Background="#0B192C" BorderBrush="#3D5473" BorderThickness="1" CornerRadius="6" Padding="13,11">
                                <StackPanel>
                                    <TextBlock x:Name="ConfirmationPathLabel" Style="{StaticResource MetadataText}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="ConfirmationPathText" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                <Button x:Name="ConfirmationCancelButton" Style="{StaticResource GhostButton}" IsDefault="True" Padding="20,10" Margin="0,0,10,0" Click="ConfirmationCancel_Click"/>
                                <Button x:Name="ConfirmationDeleteButton" Style="{StaticResource GhostButton}" Background="#653A38" BorderBrush="#BC7967" Foreground="#FFF0E8"
                                        local:Motion.HoverBackground="#854D43" local:Motion.PressedBackground="#542F2F" local:LauncherIcon.Kind="Trash" Padding="20,10" Click="ConfirmationDelete_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
