<Window x:Class="PawsPatchLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paw's Patch Launcher" Width="1240" Height="760" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource NightBrush}">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#07101F" Offset="0"/>
            <GradientStop Color="#0A1930" Offset="0.52"/>
            <GradientStop Color="#07101F" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#B2132541"/>
            <Setter Property="BorderBrush" Value="#3D5473"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1B304D"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="#60738D"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#162A45"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background" Value="#1B304D"/>
            <Setter Property="BorderBrush" Value="#526984"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="9,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#4A3C20"/>
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#594A2A" BorderThickness="1" Background="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="#B00A1425" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="P A W ' S   P A T C H" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GoldBrightBrush}"/>
                    <TextBlock Text="  /  KOHAN II" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="LanguageButton" Width="58" Height="32" Margin="0,7,6,7" Style="{StaticResource GhostButton}" Padding="4" Click="LanguageButton_Click">EN</Button>
                    <Button Width="42" Height="46" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="18" Click="MinimizeButton_Click">−</Button>
                    <Button Width="46" Height="46" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="16" Click="CloseButton_Click">×</Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#A90A1528" BorderBrush="#344967" BorderThickness="0,0,1,0">
                    <Grid Margin="18,26,18,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Width="108" Height="108" HorizontalAlignment="Center">
                            <Ellipse Fill="#172942" Stroke="{StaticResource GoldBrush}" StrokeThickness="2"/>
                            <Ellipse Margin="10" Stroke="#806A38" StrokeThickness="1"/>
                            <TextBlock Text="P" FontFamily="Georgia" FontWeight="Bold" FontSize="58" Foreground="{StaticResource GoldBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="HomeNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="HomeNav_Click"/>
                            <Button x:Name="ModulesNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="ModulesNav_Click"/>
                            <Button x:Name="SettingsNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="SettingsNav_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4">
                            <TextBlock Text="LAUNCHER" Foreground="#708098" FontSize="10"/>
                            <TextBlock Text="0.1.0 · preview" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="30,24,30,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TitleText" FontFamily="Georgia" FontWeight="Bold" FontSize="29"/>
                            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border x:Name="ReadyStatusBadge" Grid.Column="1" CornerRadius="14" Background="#193926" BorderBrush="#3F8D64" BorderThickness="1" Padding="14,6" VerticalAlignment="Center">
                            <TextBlock x:Name="ReadyStatusText" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="13"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="GamePathLabel" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                <TextBlock x:Name="GamePathText" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,5,16,0"/>
                                            </StackPanel>
                                            <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="12,6" Click="BrowseButton_Click"/>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="GameVersionLabel" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                <TextBlock x:Name="GameVersionText" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="PatchVersionLabel" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                <TextBlock x:Name="PatchVersionText" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="ModulesTitleText" FontFamily="Georgia" FontSize="19" FontWeight="Bold" Margin="2,0,0,10"/>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#2E6A4A"><TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <TextBlock x:Name="CoreTitleText" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock x:Name="CoreDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#2B4C72"><TextBlock Text="RU" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="10"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <TextBlock x:Name="RussianTitleText" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock x:Name="RussianDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="RussianToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#56396D"><TextBlock Text="✦" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <TextBlock x:Name="ColorsTitleText" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock x:Name="ColorsDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ColorsToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#6B3B38"><TextBlock Text="↻" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock x:Name="OosTitleText" FontWeight="SemiBold" FontSize="14"/>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <RadioButton x:Name="OfficialOosRadio" GroupName="OosMode" Tag="official" Style="{StaticResource ModeRadio}" Checked="OosMode_Checked"/>
                                                <RadioButton x:Name="ContinueOosRadio" Grid.Column="2" GroupName="OosMode" Tag="continue" Style="{StaticResource ModeRadio}" Checked="OosMode_Checked"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="NewsTitleText" FontFamily="Georgia" FontWeight="Bold" FontSize="19"/>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="NewsBodyText" Foreground="#CDD5E1" TextWrapping="Wrap" FontSize="13" LineHeight="21"/>
                                </ScrollViewer>
                                <StackPanel Grid.Row="3">
                                    <TextBlock x:Name="OperationText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                    <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="UpdateButton" Style="{StaticResource GoldButton}" Click="UpdateButton_Click"/>
                        <Button x:Name="RepairButton" Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="RepairButton_Click"/>
                        <Button x:Name="LaunchButton" Grid.Column="3" Style="{StaticResource GoldButton}" Padding="30,11" Click="LaunchButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
