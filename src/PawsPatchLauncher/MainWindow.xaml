<Window x:Class="PawsPatchLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PawsPatchLauncher"
        Title="Paw's Patch Launcher" Width="1440" Height="900" MinWidth="1050" MinHeight="680"
        FontFamily="Arial" Icon="Assets/PawsPatch.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource NightBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Toggle semantics/keyboard access without a checkbox glyph: the whole card is the target. -->
        <Style x:Key="BroadcastRecipient" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RecipientCard" CornerRadius="9" BorderThickness="1"
                                local:Motion.Background="#172D46" local:Motion.BorderBrush="#304965">
                            <Grid>
                                <Border x:Name="SelectionAccent" Width="3" Margin="0,12,0,12" CornerRadius="2"
                                        HorizontalAlignment="Left" Background="#E5BF65" local:Motion.Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RecipientCard" Property="local:Motion.Background" Value="#233F5C"/>
                                <Setter TargetName="RecipientCard" Property="local:Motion.BorderBrush" Value="#58789B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RecipientCard" Property="local:Motion.Background" Value="#2B4052"/>
                                <Setter TargetName="RecipientCard" Property="local:Motion.BorderBrush" Value="#C6A457"/>
                                <Setter TargetName="SelectionAccent" Property="local:Motion.Opacity" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RecipientCard" Property="local:Motion.Background" Value="#384D5D"/>
                                <Setter TargetName="RecipientCard" Property="local:Motion.BorderBrush" Value="#EDC875"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RecipientCard" Property="local:Motion.Background" Value="#142A41"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RecipientCard" Property="local:Motion.BorderBrush" Value="#FFE1A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="RecipientCard" Property="local:Motion.Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#07101F" Offset="0"/>
            <GradientStop Color="#0A1930" Offset="0.52"/>
            <GradientStop Color="#07101F" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#B2132541"/>
            <Setter Property="BorderBrush" Value="#3D5473"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="FieldTitle" TargetType="TextBlock" BasedOn="{StaticResource CardSubtitle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MetadataText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SmallMetadataText" TargetType="TextBlock" BasedOn="{StaticResource MetadataText}">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ConfigurationInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0A1729"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="#405878"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="5"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                local:Motion.Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="local:Motion.BorderBrush" Value="#7892B3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="local:Motion.Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccountPasswordInput" TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#0A1729"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="#405878"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="128"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder" Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1B304D"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="#60738D"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#162A45"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="ReleaseCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" local:Motion.Background="#1B304D" local:Motion.BorderBrush="#60738D" BorderThickness="1" CornerRadius="4" Padding="9,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="▾" HorizontalAlignment="Right" Foreground="{StaticResource GoldBrightBrush}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="local:Motion.Background" Value="#304867"/>
                                                <Setter TargetName="ComboBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#162A45" BorderBrush="#60738D" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background" Value="#1B304D"/>
            <Setter Property="BorderBrush" Value="#526984"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder" local:Motion.Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter local:Motion.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="local:Motion.Background" Value="#4A3C20"/>
                                <Setter TargetName="ModeBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModeBorder" Property="local:Motion.Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PatchChannelChoice" TargetType="RadioButton" BasedOn="{StaticResource ModeRadio}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#594A2A" BorderThickness="1" Background="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="#B00A1425">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="P A W ' S   P A T C H" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GoldBrightBrush}"/>
                    <TextBlock Text="  /  KOHAN II" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel x:Name="TitleActions" Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="LauncherUpdateButton" Visibility="Collapsed" Height="32" Margin="0,7,12,7" Style="{StaticResource GoldButton}" Padding="12,4" Click="LauncherUpdateButton_Click"/>
                    <TextBlock x:Name="PatchChannelLabel" Style="{StaticResource MetadataText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="HeaderReleaseRadio" GroupName="HeaderPatchChannel" Tag="stable" Style="{StaticResource PatchChannelChoice}" Checked="PatchChannel_Checked"/>
                    <RadioButton x:Name="HeaderBetaRadio" GroupName="HeaderPatchChannel" Tag="beta" Style="{StaticResource PatchChannelChoice}" Margin="4,0,14,0" Checked="PatchChannel_Checked"/>
                    <Button x:Name="LanguageButton" Width="58" Height="32" Margin="0,7,6,7" Style="{StaticResource GhostButton}" Padding="4" Click="LanguageButton_Click">EN</Button>
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource TitleButton}" Width="42" Height="46" Click="MinimizeButton_Click"><local:LauncherIcon Kind="Minimize"/></Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource TitleButton}" local:Motion.HoverBackground="#753B43" local:Motion.PressedBackground="#512730" Width="46" Height="46" Click="CloseButton_Click"><local:LauncherIcon Kind="Close"/></Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="MainBody" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#A90A1528" BorderBrush="#344967" BorderThickness="0,0,1,0">
                    <Grid Margin="18,26,18,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="BrandMark" Source="{StaticResource PawAppMark}" Width="108" Height="108" HorizontalAlignment="Center"
                               AutomationProperties.Name="Paw's Patch"/>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="HomeNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="HomeNav_Click"/>
                            <Button x:Name="ModulesNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="ModulesNav_Click"/>
                            <Grid Margin="0,0,0,8">
                                <Button x:Name="FriendsNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="FriendsNav_Click"/>
                                <Border x:Name="FriendsNavBadge" Background="#B94757" CornerRadius="9" MinWidth="18" Height="18" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="FriendsNavBadgeText" FontSize="11" FontWeight="Bold" Foreground="White" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Button x:Name="SettingsNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="SettingsNav_Click"/>
                            <Button x:Name="AboutNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="AboutNav_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4">
                            <Button x:Name="AdminNav" Style="{StaticResource GhostButton}" local:LauncherIcon.Kind="Shield" HorizontalContentAlignment="Left" Margin="0,0,0,16" Visibility="Collapsed" Click="AdminNav_Click"/>
                            <TextBlock x:Name="LauncherVersionLabel" Style="{StaticResource SmallMetadataText}" Foreground="#708098"/>
                            <TextBlock x:Name="LauncherVersionText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                            <TextBlock x:Name="InstalledPatchLabel" Style="{StaticResource SmallMetadataText}" Foreground="#708098" Margin="0,12,0,0"/>
                            <TextBlock x:Name="InstalledPatchText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="WorkspaceBody" Grid.Column="1" Margin="30,12,30,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="WorkspaceHeader" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="26" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border x:Name="ReadyStatusBadge" Grid.Column="1" CornerRadius="14" Background="#193926" BorderBrush="#3F8D64" BorderThickness="1" Padding="14,6" VerticalAlignment="Center" MaxWidth="270" Margin="12,0,0,0">
                            <TextBlock x:Name="ReadyStatusText" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                        <Button x:Name="AccountHeaderButton" Grid.Column="2" Width="88" Height="70" Margin="12,0,0,0" Style="{StaticResource GhostButton}" Background="Transparent" BorderBrush="Transparent" Padding="5,0" Click="AccountHeader_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border x:Name="AccountAvatarBorder" Width="48" Height="48" CornerRadius="24" BorderThickness="1" local:Motion.BorderBrush="#60738D" local:Motion.Background="#162A45" HorizontalAlignment="Center">
                                    <Grid>
                                        <local:LauncherIcon x:Name="AccountAvatarPlaceholder" Kind="Person" Width="30" Height="30"/>
                                        <Ellipse x:Name="AccountAvatarPicture" Width="46" Height="46" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="AccountHeaderNameText" FontSize="12" MaxWidth="76" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="OptionsColumn" Width="1.6*"/>
                            <ColumnDefinition x:Name="OptionsGapColumn" Width="20"/>
                            <ColumnDefinition x:Name="NewsColumn" Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="AdminPanel" Grid.ColumnSpan="3" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="AdminHeaderPanel" Margin="0,0,12,0"/>
                            <ScrollViewer x:Name="AdminContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                                <StackPanel x:Name="AdminContentPanel" Margin="0,0,12,0"/>
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer x:Name="MainOptionsScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel x:Name="FriendsPanel" Visibility="Collapsed">
                                    <ContentControl x:Name="FriendsModerationNotice"/>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="FriendsTitleText" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button x:Name="FriendsBlockedTab" Style="{StaticResource GhostButton}" Width="30" Height="30" Padding="0" Margin="0,0,6,0" Click="FriendsBlocked_Click"><local:LauncherIcon Kind="Shield" Width="17" Height="17"/></Button>
                                                    <Button x:Name="FriendsSearchButton" Style="{StaticResource GhostButton}" Width="30" Height="30" Padding="0" Click="FriendsSearch_Click"><local:LauncherIcon Kind="Search" Width="17" Height="17"/></Button>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel x:Name="FriendsGuestPanel" Margin="0,12,0,0">
                                                <TextBlock x:Name="FriendsGuestText" Style="{StaticResource CardDescription}"/>
                                                <WrapPanel Margin="0,12,0,0">
                                                    <Button x:Name="FriendsLoginButton" Style="{StaticResource GoldButton}" Click="AccountShowLogin_Click" Margin="0,0,8,8"/>
                                                    <Button x:Name="FriendsRegisterButton" Style="{StaticResource GhostButton}" Click="AccountShowRegister_Click" Margin="0,0,0,8"/>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="FriendsSignedInPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                                <WrapPanel Margin="0,0,0,8">
                                                    <Button x:Name="FriendsChatsTab" Style="{StaticResource GhostButton}" Padding="10,7" Margin="0,0,6,6" Click="FriendsChats_Click">
                                                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="FriendsChatsTabText"/><Border x:Name="FriendsChatsBadge" Background="#B94757" CornerRadius="8" Padding="4,0" Margin="6,0,0,0" Visibility="Collapsed"><TextBlock x:Name="FriendsChatsBadgeText" FontSize="11" Foreground="White"/></Border></StackPanel>
                                                    </Button>
                                                    <Button x:Name="FriendsRequestsTab" Style="{StaticResource GhostButton}" Padding="10,7" Margin="0,0,6,6" Click="FriendsRequests_Click">
                                                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="FriendsRequestsTabText"/><Border x:Name="FriendsRequestsBadge" Background="#B94757" CornerRadius="8" Padding="4,0" Margin="6,0,0,0" Visibility="Collapsed"><TextBlock x:Name="FriendsRequestsBadgeText" FontSize="11" Foreground="White"/></Border></StackPanel>
                                                    </Button>
                                                    <Button x:Name="FriendsShowAddButton" Style="{StaticResource GhostButton}" Background="#216343" BorderBrush="#45996A" Foreground="White" local:Motion.HoverBackground="#2C7954" local:Motion.PressedBackground="#17482F" Padding="10,7" Margin="0,0,0,6" Click="FriendsShowAdd_Click"/>
                                                    <Button x:Name="FriendsBroadcastButton" Style="{StaticResource GhostButton}" Width="34" Height="34" Padding="0" Margin="6,0,0,6" Click="FriendsBroadcast_Click"><local:LauncherIcon Kind="Send" Width="19" Height="19"/></Button>
                                                </WrapPanel>
                                                <Border x:Name="FriendsSearchPanel" Background="#162A45" CornerRadius="7" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="FriendsSearchInput" Style="{StaticResource ConfigurationInput}" Margin="0" Height="34" MaxLength="64" VerticalContentAlignment="Center" TextChanged="FriendsSearch_Changed" PreviewKeyDown="FriendsSearch_KeyDown"/>
                                                        <Button x:Name="FriendsClearSearchButton" Grid.Column="1" Style="{StaticResource TitleButton}" Padding="0" Width="26" Height="32" Click="FriendsClearSearch_Click"><local:LauncherIcon Kind="Close" Width="15" Height="15"/></Button>
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="FriendsAddPanel" Background="#162A45" CornerRadius="7" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
