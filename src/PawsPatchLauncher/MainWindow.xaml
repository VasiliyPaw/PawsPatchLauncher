<Window x:Class="PawsPatchLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paw's Patch Launcher" Width="1440" Height="900" MinWidth="1050" MinHeight="680"
        FontFamily="Arial" Icon="Assets/PawsPatch.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource NightBrush}">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#07101F" Offset="0"/>
            <GradientStop Color="#0A1930" Offset="0.52"/>
            <GradientStop Color="#07101F" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#B2132541"/>
            <Setter Property="BorderBrush" Value="#3D5473"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1B304D"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="#60738D"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#162A45"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="ReleaseCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1B304D" BorderBrush="#60738D" BorderThickness="1" CornerRadius="4" Padding="9,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="▾" HorizontalAlignment="Right" Foreground="{StaticResource GoldBrightBrush}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#162A45" BorderBrush="#60738D" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background" Value="#1B304D"/>
            <Setter Property="BorderBrush" Value="#526984"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="9,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#4A3C20"/>
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#594A2A" BorderThickness="1" Background="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="#B00A1425" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="P A W ' S   P A T C H" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GoldBrightBrush}"/>
                    <TextBlock Text="  /  KOHAN II" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="LauncherUpdateButton" Visibility="Collapsed" Height="32" Margin="0,7,12,7" Style="{StaticResource GoldButton}" Padding="12,4" Click="LauncherUpdateButton_Click"/>
                    <TextBlock x:Name="BetaChannelText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,7,0"/>
                    <CheckBox x:Name="BetaChannelToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="0,0,14,0" Click="BetaChannelToggle_Click"/>
                    <Button x:Name="LanguageButton" Width="58" Height="32" Margin="0,7,6,7" Style="{StaticResource GhostButton}" Padding="4" Click="LanguageButton_Click">EN</Button>
                    <Button Width="42" Height="46" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="18" Click="MinimizeButton_Click">−</Button>
                    <Button Width="46" Height="46" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="16" Click="CloseButton_Click">×</Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#A90A1528" BorderBrush="#344967" BorderThickness="0,0,1,0">
                    <Grid Margin="18,26,18,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="BrandMark" Source="{StaticResource PawAppMark}" Width="108" Height="108" HorizontalAlignment="Center"
                               AutomationProperties.Name="Paw's Patch"/>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="HomeNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="HomeNav_Click"/>
                            <Button x:Name="ModulesNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="ModulesNav_Click"/>
                            <Button x:Name="MultiplayerNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="MultiplayerNav_Click"/>
                            <Button x:Name="SettingsNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="SettingsNav_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4">
                            <TextBlock Text="LAUNCHER" Foreground="#708098" FontSize="10"/>
                            <TextBlock x:Name="LauncherVersionText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="30,24,30,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="29"/>
                            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border x:Name="ReadyStatusBadge" Grid.Column="1" CornerRadius="14" Background="#193926" BorderBrush="#3F8D64" BorderThickness="1" Padding="14,6" VerticalAlignment="Center">
                            <TextBlock x:Name="ReadyStatusText" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="MainOptionsScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel x:Name="ReliabilityPanels"/>
                                <Border x:Name="HomeWelcomeCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="HomeWelcomeTitleText" FontSize="19" FontWeight="Bold"/>
                                        <TextBlock x:Name="HomeWelcomeBodyText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="UpdateNoticeBorder" Style="{StaticResource Card}" BorderBrush="{StaticResource GoldBrush}" Background="#B23A321D" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="UpdateNoticeTitleText" Foreground="{StaticResource GoldBrightBrush}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock x:Name="UpdateNoticeBodyText" Foreground="#E7DFC9" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SettingsPanel" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="SettingsTitleText" FontSize="19" FontWeight="Bold"/>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="SettingsLanguageTitleText" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SettingsLanguageDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,12,0"/>
                                            </StackPanel>
                                            <Button x:Name="SettingsLanguageButton" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="14,7" Click="LanguageButton_Click"/>
                                        </Grid>
                                        <Grid Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="SettingsBetaTitleText" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SettingsBetaDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="SettingsBetaToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="SettingsBetaToggle_Click"/>
                                        </Grid>
                                        <Separator Margin="0,16,0,13" Background="#40536E"/>
                                        <TextBlock x:Name="SettingsRepairTitleText" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SettingsRepairDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <Button x:Name="SettingsRepairButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,11,0,0" Padding="14,7" Click="RepairButton_Click"/>
                                        <Separator Margin="0,16,0,13" Background="#40536E"/>
                                        <TextBlock x:Name="SettingsUpdatesDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="LastCheckedText" Foreground="#71819A" FontSize="10" Margin="0,9,0,0"/>
                                        <Separator Margin="0,20,0,16" Background="#70504E"/>
                                        <TextBlock x:Name="RemovalTitleText" FontSize="18" FontWeight="Bold" Foreground="#F2B6A9"/>
                                        <TextBlock x:Name="RemovePatchDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,8"/>
                                        <Button x:Name="RemovePatchButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,7" BorderBrush="#986A60" Click="RemovePatch_Click"/>
                                        <TextBlock x:Name="RemoveLauncherDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,17,0,8"/>
                                        <Button x:Name="RemoveLauncherButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,7" BorderBrush="#986A60" Click="RemoveLauncher_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="GameInfoCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="13"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="GamePathLabel" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                <TextBlock x:Name="GamePathText" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,5,16,0"/>
                                            </StackPanel>
                                            <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="12,6" Click="BrowseButton_Click"/>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="GameVersionLabel" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                <TextBlock x:Name="GameVersionText" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="PatchVersionLabel" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                <TextBlock x:Name="PatchVersionText" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="ModulesTitleText" FontSize="19" FontWeight="Bold" Margin="2,0,0,10" Visibility="Collapsed"/>

                                <Border x:Name="MultiplayerNoteCard" CornerRadius="6" Background="#B238301D" BorderBrush="#8C7137" BorderThickness="1" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚔" Foreground="{StaticResource GoldBrightBrush}" FontSize="15" Margin="0,0,9,0"/>
                                        <TextBlock x:Name="MultiplayerNoteText" Foreground="#E7DFC9" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="CoreModuleCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#2E6A4A"><TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="CoreTitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.core" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CoreDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="RussianModuleCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#2B4C72"><TextBlock Text="RU" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="10"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="RussianTitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.ru" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="RussianDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="RussianToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="ColorsModuleCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#56396D"><TextBlock Text="✦" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="ColorsTitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.colors" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ColorsDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ColorsToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="OosModuleCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#6B3B38"><TextBlock Text="↻" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="OosTitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.oos" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <RadioButton x:Name="OfficialOosRadio" GroupName="OosMode" Tag="official" Style="{StaticResource ModeRadio}" Checked="OosMode_Checked"/>
                                                <RadioButton x:Name="ContinueOosRadio" Grid.Column="2" GroupName="OosMode" Tag="continue" Style="{StaticResource ModeRadio}" Checked="OosMode_Checked"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="IndependentHostilityCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#70402F"><TextBlock Text="⚔" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="IndependentTitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.independent" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="IndependentDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="IndependentHostilityToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="GameplayOptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="RoamingSpawnCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#315C68"><TextBlock Text="⌛" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="RoamingSpawnTitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.spawn" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <RadioButton x:Name="StandardSpawnRadio" GroupName="SpawnMode" Tag="standard" Style="{StaticResource ModeRadio}" Checked="SpawnMode_Checked"/>
                                                <RadioButton x:Name="X4SpawnRadio" Grid.Column="2" GroupName="SpawnMode" Tag="x4" Style="{StaticResource ModeRadio}" Checked="SpawnMode_Checked"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="AdditionalRoamingCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#4A4F78"><TextBlock Text="➜" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="AdditionalRoamingTitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.roaming" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AdditionalRoamingDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AdditionalRoamingToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="GameplayOptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="SiegeBalanceCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#755327"><TextBlock Text="◉" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SiegeBalanceTitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="modules.siege" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SiegeBalanceDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SiegeBalanceToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="GameplayOptionChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="ConfigurationCodeCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ConfigurationTitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource HelpButton}" Tag="configuration" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ConfigurationDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <Border Background="#0A1729" BorderBrush="#405878" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,10,0,9">
                                            <TextBlock x:Name="ConfigurationCodeText" Foreground="{StaticResource GoldBrightBrush}" TextWrapping="Wrap"/>
                                        </Border>
                                        <Button x:Name="CopyConfigurationButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,7" Click="CopyConfigurationButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="ConfigurationImportHost"/>

                                <Border x:Name="DiagnosticsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="DiagnosticsTitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource HelpButton}" Tag="diagnostics" Margin="8,0,0,0" Click="HelpButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DiagnosticsDescriptionText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="DiagnosticsButton" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="14,7" VerticalAlignment="Center" Click="DiagnosticsButton_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="NewsTitleText" FontWeight="Bold" FontSize="19"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button x:Name="PatchChangelogButton" Style="{StaticResource GhostButton}" Tag="patch" Padding="14,6" Click="ChangelogTab_Click"/>
                                    <Button x:Name="LauncherChangelogButton" Style="{StaticResource GhostButton}" Tag="launcher" Padding="14,6" Margin="8,0,0,0" Click="ChangelogTab_Click"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Padding="0,0,10,0">
                                    <StackPanel x:Name="NewsEntriesPanel"/>
                                </ScrollViewer>
                                <StackPanel Grid.Row="5">
                                    <TextBlock x:Name="OperationText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                    <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="100" Value="0"/>
                                    <TextBlock x:Name="TransferText" Visibility="Collapsed" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <Button x:Name="CancelDownloadButton" Visibility="Collapsed" Style="{StaticResource GhostButton}" Padding="9,5" Margin="0,6,0,0" Click="CancelDownload_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="UpdateButton" Style="{StaticResource GoldButton}" Click="UpdateButton_Click"/>
                        <Button x:Name="CheckUpdatesButton" Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="CheckUpdatesButton_Click"/>
                        <Button x:Name="LaunchButton" Grid.Column="3" Style="{StaticResource GoldButton}" Padding="30,11" Click="LaunchButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>

            <Border x:Name="HelpOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Background="#D907101F" Visibility="Collapsed">
                <Grid>
                    <Border Width="520" MaxWidth="520" Background="#132541" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="9" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#3B5375" BorderBrush="{StaticResource GoldBrightBrush}" BorderThickness="1" Margin="0,0,12,0">
                                    <TextBlock Text="?" Foreground="{StaticResource GoldBrightBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="HelpTitleText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="HelpBodyText" Foreground="#D5DDE8" FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,18,0,20"/>
                            <Button x:Name="HelpCloseButton" Style="{StaticResource GoldButton}" HorizontalAlignment="Right" Padding="22,9" Click="HelpCloseButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
