	[ShowGameplayButton Template=ToggleButtonWidget]
	{
		[View Template = GroupVE]
		{
			L = 69
			T = 19
			R = +52
			B = +39
			
			[Child Template=DecalVE]
			{
				when = ENABLED + UNSELECTED
				texture = /UI/%s/Default/Tabs/GeneralTabUnpressed.png
			}	
				
			[Child Template=DecalVE]
			{	
				when = ENABLED + SELECTED
				texture = /UI/%s/Default/Tabs/GeneralTabPressed.png
			}
		}
		
		Tooltip = "#options_dialog_ShowGameplayButton_Tooltip"
	}
	
