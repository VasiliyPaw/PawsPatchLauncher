
;; ---------------------------- Options Menu ----------------------------

[Template OptionsCheckboxGroupVE  Template=GroupVE]
{
   	L = 10
   	;; Clients should specify the T field, all others are the same
 	R = 10r
   	B = +20
}

[Template OptionsCheckboxSharedMediumLeftLabelVE Template=SharedMediumLeftLabelVE]
{
	L = 26
	T = 2
   	R = 4r
}

[Template OptionsBoundsSliderAdvancedWidget Template=SharedSliderAdvancedWidget]
{
	show_current_val = false
	usage_area_absolute = 55, -55
	
	[View]
	{
		L = 0
		R = 0r
		B = +20
	}

	[MaxBoundLabel]
	{
		[View]
		L = 50r
	}	
}

[Template OptionsCurrentSliderAdvancedWidget Template=SharedSliderAdvancedWidget]
{
	show_minmax = false
	usage_area_absolute = 55, -55
	
	[View Template = GroupVE]
	{
		L = 0
		R = 0r
		B = +20
		
		[Child Template = DecalVE]
		{
			L = 50r
			T = 2
			R = +39
			B = +15
			
			texture = /UI/Default/SliderBar/valueslot.png
		}
	}
	
	[CurrentValueLabel]
	{
		[View]
		{
			L = 44r
		}
	}
}

[Template OptionsPsuedoTabLabelWidget Template=LabelWidget]
{
	[View Template=DecalVETiledHorizontal]
	{
		R = +175
		B = +40
		
		center_texture = /UI/%s/Default/Tabs/paneltabcenter.png
		ends_texture = /UI/%s/Default/Tabs/paneltabends.png				
	}
			
	[Label Template=SharedMediumLeftLabelVE]
	{
		L = 13
		T = 8
	}
}

[Template OptionsLeftPsuedoTabLabelWidget Template=OptionsPsuedoTabLabelWidget]
{
	[View]
	L = 15
}

[Template OptionsRightPsuedoTabLabelWidget Template=OptionsPsuedoTabLabelWidget]
{
	[View]
	L = 347
}

[Template OptionsColumnPanel Template=SharedSmallPanelWidget]
{
	[View]
	{
		;; cwp040804 - children no longer being defined in template, so must be defined here
		[Child Template = SharedChildSmallPanelVE]
		alpha_blending = false
	}
}

[Template OptionsLeftColumnPanel Template=OptionsColumnPanel]
{
	[View]
	{
		L = 14
		R = +317
	}
}

[Template OptionsRightColumnPanel Template=OptionsColumnPanel]
{
   	[View]
   	{
   		L = 346
   		R = 15r
   	}
}

[OptionsDialog Inherit=PanelWidget]
{
	[RenderThreshold]
	render_threshold = 20

	[View Template=GroupVE]
	{
		L = 150
		T = 87
		R = 150r
		B = 87b
		
		validate_decal_children = false
		
		[Child Template = SharedChildLargePanelVE]
		{
			alpha_blending = false
		}
		
		[Child Template = DecalVETiledHorizontal]
		{
			L = 23
			T = 19
			R = 23r
			B = +50

			alpha_blending = true
			
			center_texture = /UI/%s/Default/Tabs/topTabbarCenter.tga
			ends_texture = /UI/%s/Default/Tabs/topTabbarEnds.tga
		}
	
		[Child Template = DecalVETiledHorizontal]
		{
			L = 23
			T = 98b
			R = 23r
			B = +19

			alpha_blending = true
			
			ends_texture = /UI/Default/Panel/paneldividerends.tga
			center_texture = /UI/Default/Panel/paneldividercenter.tga
		}
	}

	
	[OptionsButtonDefaults Template=MenuPushButtonWidget]
	{
		[Client]
		{
			[View]
			text = "#options_dialog_OptionsButtonDefaults_Client_View_text"
		}

		[View]
		{
			L = 542r
			T = 78b
		}
	}
	
