[SAI template = SAI]
{
	IDS									= human_hard_2
	name								= "#human_hard_2_name"
	description							= "#human_hard_2_description"
	difficulty_level					= sai_difficulty_level_hard
	initial_ego							= human_hard_initial_ego_2

	[Ego]
	ids									= human_hard_main_path_ego_2
	[Ego]
	ids									= human_hard_emergency_ego_2

	[Nation]
	ids									= human

	[Faction]
	ids									= council
	[Faction]
