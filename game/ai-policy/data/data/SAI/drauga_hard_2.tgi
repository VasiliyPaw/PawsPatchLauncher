;;  Drauga Hard 2 SAI (Sarvar the Mad Rusher)
;;
;;	DESCRIPTION:  
;;		- Maintain a minimum of 2 settlements (which means if we only have one we'll attempt to
;;			settle a second
;;		- Once two settlements are in place, rush with whatever is handy (hopefully lots of raiders)

[SettlementTemplate template = SettlementTemplate]
{
	IDS										= drauga_need_settlements_build_template_2
	name									= "#drauga_hard_2_drauga_need_settlements_build_template_2_name"

	[Filters]
	{
		instances_max						= 1
	}

	[Priority]
	priority								= 1000


	[Build]
	IDS										= drauga_blacksmith
	build_next_item_priority				= 400
	build_later_item_priority				= 400
	build_next_item_precursor_priority		= 400
	build_later_item_precursor_priority		= 400
	destroy_mismatch_priority				= 0

	[Build]
	IDS										= drauga_market
	build_next_item_priority				= 100
	build_later_item_priority				= 100
	build_next_item_precursor_priority		= 100
	build_later_item_precursor_priority		= 100
	destroy_mismatch_priority				= 0

	[Build]
	IDS										= drauga_woodmill
	build_next_item_priority				= 50
	build_later_item_priority				= 50
	build_next_item_precursor_priority		= 50
	build_later_item_precursor_priority		= 50
	destroy_mismatch_priority				= 0

	[Build]
	IDS										= drauga_library
	build_next_item_priority				= 50
	build_later_item_priority				= 50
	build_next_item_precursor_priority		= 50
	build_later_item_precursor_priority		= 50
	destroy_mismatch_priority				= 0
	
	[Build]
	IDS										= drauga_shrine
	build_next_item_priority				= 50
	build_later_item_priority				= 50
	build_next_item_precursor_priority		= 50
	build_later_item_precursor_priority		= 50
	destroy_mismatch_priority				= 0

	[Build]
	IDS										= drauga_barracks
	build_next_item_priority				= 50
	build_later_item_priority				= 50
	build_next_item_precursor_priority		= 50
	build_later_item_precursor_priority		= 50
	destroy_mismatch_priority				= 0
}

