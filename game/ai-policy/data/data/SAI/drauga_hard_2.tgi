;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  Ego #1	Try to get to 2 settlements
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
[Ego template = DefaultK2EgoHardRusher]
{
	IDS									= drauga_hard_rusher_need_settlements_ego_2
	name								= "#drauga_hard_2_drauga_hard_rusher_need_settlements_ego_2_name"
	
	priority							= 1000
	
	[Filters]
	{
		[Item]
		stat							= SETTLEMENTS_OWNED
		min								= 0
		max								= 1

		[Item]
		stat							= gold_rate
		min								= 0
		max								= 999999
	}
		
	[GoalEngine]
	{	
		[GeneralSettings]
		{
			think_frequency				= 20
		}	
	
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
		;;  INITIAL CONSTANT VALUES
		[GoalPriority]
		{
			goal_IDS					= REPAIR
			multiplier					= 20
		}

		[GoalPriority]
		{
			goal_IDS					= CONSTRUCT
			multiplier					= 4
			minimum						= 100
		}

		[GoalPriority]
		{
			goal_IDS					= RECOVER
			multiplier					= 3
		}

		[GoalPriority]
		{
			goal_IDS					= DESTROY
			multiplier					= 1
			minimum						= 100
		}

		[GoalPriority]
		{
			goal_IDS					= DEFEND_REGION
			multiplier					= 1
		}

		[GoalPriority]
		{
			goal_IDS					= RESEARCH
			multiplier					= 0
		}
		;;
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

		[GoalPriority]
		{
			goal_IDS					= BUILD
			multiplier					= 3
			minimum						= 20
		}

		[GoalPriority]
		{
			goal_IDS					= ATTACK_REGION
			multiplier					= 1
			bonus						= 5000
		}

		[GoalPriority]
		{
			goal_IDS					= EXPLORE
			multiplier					= 1
		}

		[GoalPriority]
		{
			goal_IDS					= RECRUIT
			multiplier					= 0.5
		}

		[GoalPriority]
		{
			goal_IDS					= UPGRADE
			multiplier					= 1
			minimum						= 60
		}

		[ResourceManagement]
		{
			[ResourceNeed]
			{
				resource_IDS			= mana
				short_need				= 0
				enough_need				= 8
				plenty_value			= 10
				plenty_need				= 1
			}

			[ResourceNeed]
			{
				resource_IDS			= Kingdom_points_provided
				short_need				= 0
				enough_need				= 12
				plenty_value			= 16
				plenty_need				= 1
			}

		} ;; ResourceManagement

		[Recruiting]
		{

			[SpecificRecruitRequest]
			{
				property_ids				= role_settler
				number_to_request			= 1
				base_priority				= 6000
				economic_value_multiplier	= 0
				repeat_penalty				= 6000
			}

			[SpecificRecruitRequest]
			{
				property_ids				= company_melee
				number_to_request			= 2
				base_priority				= 8000
				economic_value_multiplier	= 0
				repeat_penalty				= 6000
			}

			[SpecificRecruitRequest]
			{
				property_ids				= company_cavalry
				number_to_request			= 1
				base_priority				= 5000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 6000
			}

			[SpecificRecruitRequest]
			{
				property_ids				= company_sovereign_drauga
				number_to_request			= 1
				base_priority				= 3000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 8000
			}

		} ;; Recruiting

		[ActorPriority]
		{
			actor_IDS					= drauga_ironexport
			value						= -500
		}

		[ActorPriority]
		{
			actor_IDS					= drauga_woodexport
			value						= -375
		}

		[ActorPriority]
		{
			actor_IDS					= drauga_center_city
			value						= -500
		}

		[Exploration]
		{
			[CloseGoals]
			{
				num_goals								= 2
				
				base_priority							= 200
				repeat_penalty							= 0

				intuition_region_bonus					= 150
				intuition_count_mines					= false
				intuition_count_settlement_spots		= true
				intuition_count_settlements				= false
				intuition_count_other_buildings			= false

				consider_distance_to_kingdom_center		= true
				kingdom_center_distance_prefer_close	= true

				consider_distance_to_last_region		= true
				last_region_distance_prefer_close		= true

				consider_distance_to_actor				= true
				actor_distance_prefer_close				= true
			}

			[DeepGoals]
			{
				num_goals								= 0
				use_time_since_last_scouted				= false
			}
		}
	} ;; GoalEngine

	[SettlementTemplate]
	IDS									= drauga_need_settlements_build_template_2
}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  Ego #2	We have 2 settlements - recruit and attack
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[Ego template = DefaultK2EgoHardRusher]
{
	IDS									= drauga_hard_rusher_attack_ego_2
	name								= "#drauga_hard_2_drauga_hard_rusher_attack_ego_2_name"

	priority							= 1000

	[Filters]
	{
		[Item]
		stat							= SETTLEMENTS_OWNED
		min								= 2
		max								= 1000

		[Item]
		stat							= gold_rate
		min								= 20
		max								= 999999
	}
	
	[GoalEngine]
	{
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
		;;  MAIN CONSTANT VALUES
		[GoalPriority]
		{
			goal_IDS					= REPAIR
			multiplier					= 20
		}

		[GoalPriority]
		{
			goal_IDS					= CONSTRUCT
			multiplier					= 5
			minimum						= 100
		}

		[GoalPriority]
		{
			goal_IDS					= RECOVER
			multiplier					= 3
		}

		[GoalPriority]
		{
			goal_IDS					= DESTROY
			multiplier					= 1
			minimum						= 100
		}

		[GoalPriority]
		{
			goal_IDS					= EXPLORE
			multiplier					= 1
		}

		[GoalPriority]
		{
			goal_IDS					= DEFEND_REGION
			multiplier					= 1
		}

		[GoalPriority]
		{
			goal_IDS					= RESEARCH
			multiplier					= 0.2
		}
		;;
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

		[GoalPriority]
		{
			goal_IDS					= BUILD
			multiplier					= 3
			minimum						= 30
		}

		[GoalPriority]
		{
			goal_IDS					= ATTACK_REGION
			multiplier					= 1
			bonus						= 1250
		}

		[GoalPriority]
		{
			goal_IDS					= RECRUIT
			multiplier					= 0.5
		}

		[GoalPriority]
		{
			goal_IDS					= UPGRADE
			multiplier					= 2
			minimum						= 120
		}

		[Recruiting]
		{
			int max_goals_per_think				= 5
			int num_military_goals				= 3

			[SpecificRecruitRequest]
			{
				property_ids				= company_sovereign_drauga
				number_to_request			= 1
				base_priority				= 3000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 10000
			}

			[SpecificRecruitRequest]
			{
				property_ids				= company_mage
				number_to_request			= 4
				base_priority				= 7000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 6000
			}

			[SpecificRecruitRequest]
			{
				property_ids				= company_cavalry
				number_to_request			= 4
				base_priority				= 5000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 10000
			}
		
			[SpecificRecruitRequest]
			{
				property_ids				= company_siege
				number_to_request			= 4
				base_priority				= 4000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 7000
			}

		} ;; Recruiting

		[Exploration]
		{
			[CloseGoals]
			{
				num_goals								= 1
				
				base_priority							= 200
				repeat_penalty							= 0

				intuition_region_bonus					= 100
				intuition_count_mines					= true
				intuition_count_settlement_spots		= true
				intuition_count_settlements				= true
				intuition_count_other_buildings			= true

				consider_distance_to_kingdom_center		= true
				kingdom_center_distance_prefer_close	= true

				consider_distance_to_last_region		= true
				last_region_distance_prefer_close		= true

				consider_distance_to_actor				= true
				actor_distance_prefer_close				= true
			}

			[DeepGoals]
			{
				num_goals								= 2
				
				base_priority							= 200
				repeat_penalty							= 0

				current_region_bonus					= 0
				actor_region_bonus						= 0
				building_region_bonus					= 0
				flare_region_bonus						= 1000

				intuition_region_bonus					= 100
				intuition_count_mines					= true
				intuition_count_settlement_spots		= true
				intuition_count_settlements				= true
				intuition_count_other_buildings			= true

				consider_distance_to_kingdom_center		= true
				kingdom_center_distance_prefer_close	= false

				consider_distance_to_last_region		= false

				consider_distance_to_actor				= true
				actor_distance_prefer_close				= true
			}
		}
	} ;; GoalEngine

	[SettlementTemplate]
	IDS									= drauga_attack_build_template_2
}

