[SAI template = SAI]
{
	IDS									= drauga_hard_2
	name								= "#drauga_hard_2_name"
	description							= "#drauga_hard_2_description"
	difficulty_level					= sai_difficulty_level_hard
	initial_ego							= drauga_hard_rusher_need_settlements_ego_2

	[Ego]
	ids									= drauga_hard_rusher_attack_ego_2

	[Ego]
	ids									= draugarusher_hard_emergency_ego_2
	[Nation]
	ids									= Drauga

	[Faction]
	ids									= nationalist
	[Faction]
	ids									= royalist
}