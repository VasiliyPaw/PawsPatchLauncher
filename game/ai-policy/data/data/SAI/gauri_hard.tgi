;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;	Default Gauri Template
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[template GauriDefaultK2Ego_1 template = DefaultK2EgoHard]
{
	[GoalEngine]
	{
		[Recruiting]
		{
			;; PAW_AI_MASS_SIEGE_R1
			[SpecificRecruitRequest]
			{
				recruit_ids = company_dragonfire_balistae
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_Maelstrom_engine
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_vorpal_engine
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_crimson_catapult
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_plague_catapult
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}


			[SpecificRecruitRequest]
			{
				property_ids				= company_melee
				number_to_request			= 2
				base_priority				= 6000
				economic_value_multiplier	= 0
				repeat_penalty				= 7000
			}
		
			[SpecificRecruitRequest]
			{
				property_ids				= company_ranged
				number_to_request			= 1
				base_priority				= 7000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 8000
			}

			[SpecificRecruitRequest]
			{
				property_ids				= role_settler
				number_to_request			= 1
				base_priority				= 4000
				economic_value_multiplier	= 0
				repeat_penalty				= 10000
			}
		} ;; Recruiting
	} ;; GoalEngine
} ;; GauriDefaultEgo

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  Ego #1	( Initial Ego ) Build and Explore
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
[Ego template = GauriDefaultK2Ego_1]
{
	IDS									= gauri_hard_initial_ego_1
	name								= "#gauri_hard_initial_ego_1_name"
	
	priority							= 1000

	[Filters]
	{		
		[Item]
		stat							= SETTLEMENTS_OWNED
		min								= 0
		max								= 1

		[Item]
		stat							= SETTLEMENTS_SURRENDERED
		min								= -1
		max								= 0

		[Item]
		stat							= gold_rate
		min								= 0
		max								= 60
	}
	
	[GoalEngine]
	{	
		[GeneralSettings]
		{
			think_frequency				= 10
		}	

		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
		;;  INITIAL CONSTANT VALUES
		[GoalPriority]
		{
			goal_IDS					= REPAIR
			multiplier					= 20
		}

		[GoalPriority]
		{
			goal_IDS					= CONSTRUCT
			multiplier					= 3
			minimum						= 100
		}

		[GoalPriority]
		{
			goal_IDS					= RECOVER
			multiplier					= 3
		}

		[GoalPriority]
		{
