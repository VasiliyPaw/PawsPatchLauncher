			multiplier					= 1
			minimum						= 100
		}

		[GoalPriority]
		{
			goal_IDS					= DEFEND_REGION
			multiplier					= 1
		}

		[GoalPriority]
		{
			goal_IDS					= RESEARCH
			multiplier					= 0
		}
		;;
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

		[GoalPriority]
		{
			goal_IDS					= BUILD
			multiplier					= 2
			minimum						= 28
		}

		[GoalPriority]
		{
			goal_IDS					= ATTACK_REGION
			multiplier					= 1
			bonus						= 350
		}

		[GoalPriority]
		{
			goal_IDS					= EXPLORE
			multiplier					= 1
		}

		[GoalPriority]
		{
			goal_IDS					= RECRUIT
			multiplier					= 0.5
		}

		[GoalPriority]
		{
			goal_IDS					= UPGRADE
			multiplier					= 1
			minimum						= 60
		}
		
		[ActorPriority]
		{
			actor_IDS					= gauri_ironexport
			value						= -500
		}

		[ResourceManagement]
		{
			[ResourceNeed]
			{
				resource_IDS			= Kingdom_points_provided
				short_need				= 0
				enough_need				= 12
				plenty_value			= 16
				plenty_need				= 1
			}

		} ;; ResourceManagement

		[Recruiting]
		{
			;; PAW_AI_MASS_SIEGE_R1
			[SpecificRecruitRequest]
			{
				recruit_ids = company_dragonfire_balistae
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_Maelstrom_engine
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_vorpal_engine
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_crimson_catapult
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_plague_catapult
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}

			insufficient_income_level		= 15

			[SpecificRecruitRequest]
			{
				property_ids				= company_melee
				number_to_request			= 2
