;; PAW_AW_CITY_PLANS_R1: racial prerequisites, one military city, no demolition.
[SettlementTemplate template = SettlementTemplate]
{
	IDS = paw_aw_shadow_hard_military_city
	name = "Paw Arcane military city"
	[Filters]
	{
		instances_max = 1
		[Item]
		stat = SETTLEMENTS_OWNED
		min = 2
		max = 10000
		[Item]
		stat = gold_rate
		min = 20
		max = 999999
	}
	[Priority]
	priority = 1600
	inertia = 400

	[Build]
	IDS = shadow_quarry
	build_next_item_priority = 800
	build_later_item_priority = 800
	build_next_item_precursor_priority = 800
	build_later_item_precursor_priority = 800
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = shadow_woodmill
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = shadow_blacksmith
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = shadow_barracks
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = shadow_shrine
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = shadow_library
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = shadow_manafocus
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
