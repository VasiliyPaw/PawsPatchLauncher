;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  Ego #1	Try to get to 2 settlements
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
[Ego template = DefaultK2EgoHardRusher]
{
	IDS									= shadow_hard_rusher_need_settlements_ego_2
	name								= "#shadow_hard_2_shadow_hard_rusher_need_settlements_ego_2_name"

	priority							= 1000

	[Filters]
	{
		[Item]
		stat							= SETTLEMENTS_OWNED
		min								= 0
		max								= 1

		[Item]
		stat							= gold_rate
		min								= 0
		max								= 999999
	}

	[GoalEngine]
	{
		[GeneralSettings]
		{
			think_frequency				= 10
		}

		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
		;;  INITIAL CONSTANT VALUES
		[GoalPriority]
		{
			goal_IDS					= REPAIR
			multiplier					= 20
		}

		[GoalPriority]
		{
			goal_IDS					= CONSTRUCT
			multiplier					= 4
			minimum						= 100
		}

		[GoalPriority]
		{
			goal_IDS					= RECOVER
			multiplier					= 3
		}

		[GoalPriority]
		{
			goal_IDS					= DESTROY
			multiplier					= 1
			minimum						= 100
		}

		[GoalPriority]
		{
			goal_IDS					= DEFEND_REGION
			multiplier					= 1
		}

		[GoalPriority]
		{
			goal_IDS					= RESEARCH
			multiplier					= 0
		}
		;;
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

		[GoalPriority]
		{
			goal_IDS					= BUILD
			multiplier					= 3
			minimum						= 30
		}

		[GoalPriority]
		{
			goal_IDS					= ATTACK_REGION
			multiplier					= 1
			bonus						= 1250
		}

		[GoalPriority]
		{
			goal_IDS					= EXPLORE
			multiplier					= 1
		}

		[GoalPriority]
		{
			goal_IDS					= RECRUIT
			multiplier					= 0.5
		}

		[GoalPriority]
		{
			goal_IDS					= UPGRADE
			multiplier					= 1
			minimum						= 60
		}

		[Recruiting]
		{
			;; PAW_AI_MASS_SIEGE_R1
			[SpecificRecruitRequest]
			{
				recruit_ids = company_dragonfire_balistae
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_Maelstrom_engine
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_vorpal_engine
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_crimson_catapult
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_plague_catapult
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}

			[SpecificRecruitRequest]
			{
				property_ids				= role_settler
				number_to_request			= 1
				base_priority				= 4000
				economic_value_multiplier	= 0
				repeat_penalty				= 10000
			}

			[SpecificRecruitRequest]
			{
				property_ids				= company_melee
				number_to_request			= 2
				base_priority				= 6000
				economic_value_multiplier	= 0
				repeat_penalty				= 10000
			}

			[SpecificRecruitRequest]
			{
				property_ids				= company_cavalry
				number_to_request			= 2
				base_priority				= 3000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 10000
			}

			[SpecificRecruitRequest]
			{
				property_ids				= company_sovereign_shadow
				number_to_request			= 1
				base_priority				= 8000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 10000
			}

		} ;; Recruiting

		[ResourceManagement]
		{
			[ResourceNeed]
			{
				resource_IDS			= Kingdom_points_provided
				short_need				= 0
				enough_need				= 12
				plenty_value			= 16
				plenty_need				= 1
			}

		} ;; ResourceManagement

		[ActorPriority]
		{
			actor_IDS					= shadow_center_city
			value						= -500
		}

		[Exploration]
		{
			[CloseGoals]
			{
				num_goals								= 5
				
				base_priority							= 200
				repeat_penalty							= 0

				intuition_region_bonus					= 150
				intuition_count_mines					= false
				intuition_count_settlement_spots		= true
				intuition_count_settlements				= false
				intuition_count_other_buildings			= false

				consider_distance_to_kingdom_center		= true
				kingdom_center_distance_prefer_close	= true

				consider_distance_to_last_region		= true
				last_region_distance_prefer_close		= true

				consider_distance_to_actor				= true
				actor_distance_prefer_close				= true
			}

			[DeepGoals]
			{
				num_goals								= 0
				use_time_since_last_scouted				= false
			}
		}
	
		[ActorPriority]
		{
			actor_IDS = shadow_center_citadel_militia
			value = 100000
		}

		[ActorPriority]
		{
			actor_IDS = shadow_center_sovereign_militia
			value = 100000
		}

		[ActorPriority]
		{
			actor_IDS = shadow_quarry
			value = 0
			one_time_bonus = 1500
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = shadow_sovereign_woodmill
			value = 0
			one_time_bonus = 250
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = shadow_sovereign_blacksmith
			value = 0
			one_time_bonus = 250
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = shadow_sovereign_barracks
			value = 0
			one_time_bonus = 250
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = shadow_sovereign_shrine
			value = 0
			one_time_bonus = 250
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = shadow_sovereign_library
			value = 0
			one_time_bonus = 250
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = shadow_sovereign_manafocus
			value = 0
			one_time_bonus = 300
			max_recruited_per_think = 1
		}
} ;; GoalEngine

	[SettlementTemplate]
	IDS									= shadow_need_settlements_build_template_2

	[SettlementTemplate]
	IDS = paw_aw_shadow_hard_2_military_city
}

