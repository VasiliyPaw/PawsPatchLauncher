;; PAW_AW_CITY_PLANS_R1: racial prerequisites, one military city, no demolition.
[SettlementTemplate template = SettlementTemplate]
{
	IDS = paw_aw_undead_hard_2_military_city
	name = "Paw Arcane military city"
	[Filters]
	{
		instances_max = 1
		[Item]
		stat = SETTLEMENTS_OWNED
		min = 2
		max = 10000
		[Item]
		stat = gold_rate
		min = 20
		max = 999999
	}
	[Priority]
	priority = 1600
	inertia = 400

	[Build]
	IDS = undead_quarry
	build_next_item_priority = 800
	build_later_item_priority = 800
	build_next_item_precursor_priority = 800
	build_later_item_precursor_priority = 800
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = undead_woodmill
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = undead_blacksmith
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = undead_barracks
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = undead_shrine
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = undead_library
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120

	[Build]
	IDS = undead_manafocus
	build_next_item_priority = 250
	build_later_item_priority = 100
	build_next_item_precursor_priority = 250
	build_later_item_precursor_priority = 100
	destroy_mismatch_priority = 0
	upgrade_settlement_priority = 120
}

;;  Undead Hard 2 SAI (Cincixri - the powerful)
;;
;;  Description:
;;		Cincixri wants to achieve decisive victories using overwhelming force.  He will
;;		avoid battles that he cannot win, preserving his forces for a sure victory

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;	Default Undead Template
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[template UndeadDefaultK2Ego_2 template = DefaultK2EgoHard]
{
	[GoalEngine]
	{
		[Recruiting]
		{
			;; PAW_AI_MASS_SIEGE_R1
			[SpecificRecruitRequest]
			{
				recruit_ids = company_dragonfire_balistae
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_Maelstrom_engine
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_vorpal_engine
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_crimson_catapult
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_plague_catapult
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}

  			replace_company_cv_mult			= 0.85

  
			[SpecificRecruitRequest]
			{
				property_ids				= role_settler
				number_to_request			= 1
				base_priority				= 4000
				economic_value_multiplier	= 0
				repeat_penalty				= 10000
			}

			[SpecificRecruitRequest]
			{
				property_ids				= company_ranged
				number_to_request			= 2
				base_priority				= 7000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 10000
			}
		
			[SpecificRecruitRequest]
			{
				property_ids				= company_cavalry
				number_to_request			= 2
				base_priority				= 3000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 10000
			}

		} ;; Recruiting
	}
} ;; UndeadDefaultEgo

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  Ego #1	( Initial Ego ) Build and Explore
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
[Ego template = UndeadDefaultK2Ego_2]
{
	IDS									= undead_hard_initial_ego_2
	name								= "#undead_hard_2_undead_hard_initial_ego_2_name"
	
	priority							= 1000
	
	;;  NOTE:  Stay in this ego if we...
	[Filters]
	{		
		;;  1.  have less than 3 settlements
		[Item]
		stat							= SETTLEMENTS_OWNED
		min								= 0
		max								= 1

		;;  2.  haven't lost a settlement to the enemy
		[Item]
		stat							= SETTLEMENTS_SURRENDERED
		min								= -1
		max								= 0
		
		;;  3.  have a bad economy
		[Item]
		stat							= gold_rate
		min								= 0
		max								= 60		
	}

	[GoalEngine]
	{
		[GeneralSettings]
		{
			think_frequency				= 10
		}

		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
		;;  INITIAL CONSTANT VALUES
		[GoalPriority]
		{
			goal_IDS					= REPAIR
			multiplier					= 20
		}

		[GoalPriority]
		{
			goal_IDS					= CONSTRUCT
			multiplier					= 2
			minimum						= 100
		}

		[GoalPriority]
		{
			goal_IDS					= RECOVER
			multiplier					= 0.5
		}

		[GoalPriority]
		{
			goal_IDS					= DESTROY
			multiplier					= 1
			minimum						= 100
		}

		[GoalPriority]
		{
			goal_IDS					= DEFEND_REGION
			multiplier					= 1
		}

		[GoalPriority]
		{
			goal_IDS					= RESEARCH
			multiplier					= 0
		}
		;;
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

		[GoalPriority]
		{
			goal_IDS					= BUILD
			multiplier					= 2
			minimum						= 28
		}

		[GoalPriority]
		{
			goal_IDS					= ATTACK_REGION
			multiplier					= 1
			bonus						= 750
		}

		[GoalPriority]
		{
			goal_IDS					= EXPLORE
			multiplier					= 1
		}

		[GoalPriority]
		{
			goal_IDS					= RECRUIT
			multiplier					= 0.5
		}

		[GoalPriority]
		{
			goal_IDS					= UPGRADE
			multiplier					= 1
			minimum						= 60
		}

		[ResourceManagement]
		{
			settlement_reserved_resources_amt				= 90

			[ResourceNeed]
			{
				resource_IDS			= Kingdom_points_provided
				short_need				= 0
				enough_need				= 12
				plenty_value			= 16
				plenty_need				= 1
			}

		} ;; ResourceManagement

		[Recruiting]
		{
			;; PAW_AI_MASS_SIEGE_R1
			[SpecificRecruitRequest]
			{
				recruit_ids = company_dragonfire_balistae
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_Maelstrom_engine
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_vorpal_engine
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_crimson_catapult
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}
			[SpecificRecruitRequest]
			{
				recruit_ids = company_plague_catapult
				number_to_request = 6
				base_priority = 9000
				economic_value_multiplier = 0.2
				repeat_penalty = -1250
			}

			insufficient_income_level		= 10

			[SpecificRecruitRequest]
			{
				property_ids				= company_sovereign_undead
				number_to_request			= 1
				base_priority				= 8000
				economic_value_multiplier	= 0.2
				repeat_penalty				= 10000
			}
		}

		[ActorPriority]
		{
			actor_IDS					= undead_ironconvert
			value						= -500
		}

		[ActorPriority]
		{
			actor_IDS					= undead_woodconvert
			value						= -375
		}

		[ActorPriority]
		{
			actor_IDS					= undead_center_city
			value						= -500
		}

		;;  NOTE:  This is what make Cincixri attack with overwhelming force
		[OffensiveCV]
		{
			cv_advantage_target				= 1.2
			cv_advantage_max				= 5
			cv_exponent_under_target		= 4
			cv_max_mult_over_target			= 10
			min_cv_to_assign				= 10
		} ;; CV

		[Exploration]
		{
			[CloseGoals]
			{
				num_goals								= 5
				
				base_priority							= 200
				repeat_penalty							= 0

				intuition_region_bonus					= 150
				intuition_count_mines					= false
				intuition_count_settlement_spots		= true
				intuition_count_settlements				= false
				intuition_count_other_buildings			= false

				consider_distance_to_kingdom_center		= true
				kingdom_center_distance_prefer_close	= true

				consider_distance_to_last_region		= true
				last_region_distance_prefer_close		= true

				consider_distance_to_actor				= true
				actor_distance_prefer_close				= true
			}

			[DeepGoals]
			{
				num_goals								= 0
				use_time_since_last_scouted				= false
			}
		}
	
		[ActorPriority]
		{
			actor_IDS = undead_center_citadel_militia
			value = 100000
		}

		[ActorPriority]
		{
			actor_IDS = undead_center_sovereigncey_militia
			value = 100000
		}

		[ActorPriority]
		{
			actor_IDS = undead_center_sovereignfal_militia
			value = 100000
		}

		[ActorPriority]
		{
			actor_IDS = undead_quarry
			value = 0
			one_time_bonus = 1500
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = undead_sovereign_woodmill
			value = 0
			one_time_bonus = 250
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = undead_sovereign_blacksmith
			value = 0
			one_time_bonus = 250
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = undead_sovereign_barracks
			value = 0
			one_time_bonus = 250
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = undead_sovereign_shrine
			value = 0
			one_time_bonus = 250
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = undead_sovereign_library
			value = 0
			one_time_bonus = 250
			max_recruited_per_think = 1
		}

		[ActorPriority]
		{
			actor_IDS = undead_sovereign_manafocus
			value = 0
			one_time_bonus = 300
			max_recruited_per_think = 1
		}
}

	[SettlementTemplate]
	IDS									= initial_undead_build_template

	[SettlementTemplate]
	IDS = paw_aw_undead_hard_2_military_city
}

