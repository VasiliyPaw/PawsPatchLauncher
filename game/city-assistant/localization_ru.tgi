    name = "Localization/paw_city_policy.tgi"
    paw_city_auto = "Автоулучшение городов"
    paw_city_new_militia = "Открывать ополчение в городах и новых зданиях"
    paw_city_new_militia_tip = "Открывает ополчение стартовых, построенных и захваченных городов, а также новых городских зданий с ополчением. При временном запрете приказа ждёт его доступности. Если выключено, новые города и здания получают закрытое ополчение. Последующие ручные изменения и состояние готовых зданий из сейва сохраняются. Настройка сохраняется между играми."
    paw_city_reserve = "Запас золота"
    paw_city_auto_tip = "Приоритет: последнее улучшение центра, цели по ресурсам, доход золота, затем случайное развитие. Если золота не хватает, автоулучшение копит на выбранную приоритетную постройку. На этапе ресурсов рынок выбирается, только если его прирост золота после расходов на дефицит выше, чем у ресурсной постройки. Рынки улучшаются только по лучшей золотой ветке; без прироста золота не улучшаются. Учитываются вся очередь и запас золота. Настройки сохраняются для партии; новая партия начинается со стандартных."
    paw_city_edit_tip = "Enter — применить. Esc или клик вне поля — отменить."
    paw_city_status_tip = "Состояние автоулучшения городов"
    paw_city_checking = "Проверка городов…"
