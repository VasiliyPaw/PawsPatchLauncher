[CityManagement Inherit=SidePanelWidget]
{
	[View]
	{
		;; cwp040804 - Children are no longer defined in templates, so must be defined here
		[Child Template = GameChildPanelVE]
		
		        [Child Template=SharedSmallLeftLabelVE]
        {
            L = 41
            T = 435
            B = +20
            text = "#paw_city_auto"
            font = tiny
        }
        [Child Template=SharedSmallLeftLabelVE]
        {
            L = 17
            T = 500
            B = +20
            text = "#paw_city_reserve"
            font = tiny
        }
[Child Template=SharedSmallLeftLabelVE]
		{
			
			T = 15
			B = +20

			text = "#city_management_display_Child_text"
			font = small
			justify = CENTER
		}

		[Child Template=SharedSmallLeftLabelVE]
		{
			L = 41
			T = 407
			B = +20

			text = "#city_management_display_Child_text_2"
			font = tiny
		}
	}

	[ViewportSettlements Template=GameViewportScrollWidget]
	{
		[View]
		{
			L = 15
			T = 48
			R = 10r
			B = +345
		}
	}

	[Settlement Inherit=PanelWidget]
	{
		under_siege_text_color = 1,0,0

		[View Template=GroupVE]
		{
			L = 0
			T = 0
			B = +77
			R = 100%
		}

		[Name Template=LabelWidget]
		{
			;;tooltip = "Settlement Name"

			[View Template=NoVE]
			{
				L = 0
				T = 0
				R = +145
				B = +16
			}

			[Label]
			{
				text = ""	;; populated by code
				font = tiny
				justify = LEFT
			}
		}

		[Economy Template=LabelWidget]
		{
			;;tooltip = "Settlement Economy"
			
			[View Template=NoVE]
			{
				L = 148
				T = 0
				R = 100%
				B = +16
			}

			[Label]
			{
				text = ""	;; populated by code
				font = tiny
				justify = LEFT
			}
			

		}
		
		[SettlementStructures Template=SettlementStructures]
		{
			border_x = 5
			border_y = 5

			first_structure_separation = 20

			show_health = false

			[View Template=DecalVETiledHorizontal]
			{
				L = 0
				T = 20
				R = 0r
				B = +50

				ends_texture = /UI/%s/Game/Panel/SettlementBarEnds.png
				center_texture = /UI/%s/Game/Panel/SettlementBarCenter.png
			}

			[SettlementStructure]
			{
				[View]
				{
					L = 5
					T = 5
					R = +38
					B = +38
				}
			
				[StructureButton]
				{
					pressed_client_L = 3
					pressed_client_T = 3
					pressed_client_R = 3r
					pressed_client_B = 3b

					[View]
					{
						[Child Template=DecalVE]
						when = ENABLED + UNFOCUSED
						texture = /UI/%s/Game/SharedTextures/ComponentButtonUnfocused.png

						[Child Template=DecalVE]
						when = ENABLED + FOCUSED
						texture = /UI/%s/Game/SharedTextures/ComponentButtonFocused.png
						
						[Child Template=DecalVE]
						when = ENABLED + TARGETED
						texture = /UI/%s/Game/SharedTextures/ComponentButtonTargeted.tga
						
						/* cwp040704 -- removed for consistency, if other buttons start using
							a pressed frame, uncomment this.
						[Child Template = DecalVE]
						when = ENABLED + PRESSED
						texture = /UI/%s/Game/SharedTextures/ComponentButtonPressed.png
						*/
					}
					
					[StructureButtonDecal]
					{
						[View]
						{
							L = 2
							T = 2
							R = +34
							B = +33
						}
					}
				}
			}

			;; health bar not displayed so need to set
		}
	}

	[ButtonAutoPlacement Template=GameToggleButtonWidget]
	{
		tooltip = "#city_management_display_ButtonAutoPlacement_tooltip"

		[View]
		{
			L = 16
			T = 404
		}
	}

