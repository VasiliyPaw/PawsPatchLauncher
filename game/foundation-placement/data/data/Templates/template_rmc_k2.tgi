[Template K2RMC template=RMC]
{
	;; Native RMG chooses one shared starting Sun; explicit world rules override it.
	string sun = sun_default,sun_morning,sun_dusk,sun_night

	reference_size = 256

/*	RULES				*/

	[Rules]
	{
		game_type = PLAYABLE

		[Rule]
		ids = Sun
		default = sun_default
		
         [Rule]  
         ids = difficultylevel
         default = EASY
         show_ui = false 
	}
	
/*	KINGDOMS			*/

	[Kingdom Template=RMCKingdomMajor]
	{
		IDS = kingdom01
		name = "#template_rmc_k2_kingdom01_name"
		color = blue
		team = null
		playable = true
		required = false
		SAI_default_ids = null
	}

	[Kingdom Template=RMCKingdomMajor]
	{
		IDS = kingdom02
		name = "#template_rmc_k2_kingdom02_name"
		color = red
		team = null
		playable = true
		required = false
		SAI_default_ids = null
	}

