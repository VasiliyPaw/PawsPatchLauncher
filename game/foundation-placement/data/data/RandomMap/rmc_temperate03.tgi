
[RMC template=K2AllRMC]
{
	IDS = rmc_temperate03
	name = "#rmc_temperate03_name"
	description = "#rmc_temperate03_description"
	biome = temperate

/* 	TERRAIN			*/

	[TerrainBlob Template=TempGrassTerrainBlob]
	
	[TerrainStreak Template=TempGrassYellowTerrainStreak]

	[TerrainBlob Template=TempGrassYellowTerrainBlob]
	
	[TerrainBlob Template=TempRoughTerrainBlob]
	
	[TerrainBlob Template=TempMarshTerrainBlob]
	
	[TerrainStreak Template=TempForestConiferousTerrainStreak]

	[TerrainBlob Template=TempForestConiferousTerrainBlob]
	
	[TerrainStreak Template=TempForestDeciduousTerrainStreak]

	[TerrainBlob Template=TempForestDeciduousTerrainBlob]
	
	[TerrainBlob Template=TempRoughTerrainBlob02]
	
	[TerrainBlob Template=TempMarshTerrainBlob02]
	
	[TerrainBlob Template=TempGrassYellowTerrainBlob02]
	
	[TerrainBlob Template=TempGrassTerrainBlob02]

/*************************** AW TERRAIN ****************************/

	[TerrainBlob Template=TempRockyGrassTerrainBlob]

	[TerrainBlob Template=TempRockyGrassTerrainBlob02]
	
	[TerrainStreak Template=TempForestDenseAncientTerrainStreak]

	[TerrainBlob Template=TempForestDenseAncientTerrainBlob]

	[TerrainBlob Template=TempMistSwampTerrainBlob]
	
	[TerrainBlob Template=TempMistSwampTerrainBlob02]
	
	[TerrainStreak Template=TempMeadowTerrainStreak]

/* 	BLOCKING TERRAIN	*/

	[TerrainBlob Template=TempMountainTerrainBlob]
	
	[TerrainBlob Template=TempMountainTerrainBlob02]

	[TerrainBlob Template=TempMountainTerrainBlob03]

	[TerrainBlob Template=TempLakeTerrainBlob]

/*	TERRAIN NOISE			*/

	[TerrainNoise Template=TempNoisePhasePre01]
	
	[TerrainNoise Template=TempNoisePhase01]
	
	[TerrainNoise Template=TempNoisePhase02]
	
	[TerrainNoise Template=TempNoisePhase03]
	
	[TerrainNoise Template=TempNoisePhase04]

	[TerrainNoise Template=TempNoisePhase05]

	[TerrainNoise Template=TempNoisePhase06]

/*	ACTOR GROUPS ASSIGNED TO KINGDOMS	*/

	[ActorGroup Template=StartSettlement]
	apply_to_all_major_kingdoms = true

/*	OTHER ACTOR GROUPS 			*/

	[ActorGroup Template=RandomSettlementGroup]

	[ActorGroup Template=FoundationCamps]

	[ActorGroup Template=SettlementCamps]

	[ActorGroup Template=RandomEnclaveGroup]


	[ActorGroup Template=CampTechGroup]

	[ActorGroup Template=CampArtifactGroup]

	[ActorGroup Template=CampTemperateLairGroup]

	[ActorGroup Template=CampTemperateTechGroup]

	[ActorGroup Template=CampTemperateLargeLairGroup]

	[ActorGroup Template=CampResourceGroup]

	[ActorGroup Template=TemperateFlock]

	[ActorGroup Template=TemperateHerd]

	[ActorGroup Template=TemperateSchool]
}

