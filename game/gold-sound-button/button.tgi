	;; Independent local sound button; never registered as an actor/team command.
	;; Above the lower-right command panel, with room for its complete tab row.
	;; At 2560x1440: frame 100x100; image 95x95 (1:1).
	[PawGoldSoundButton Template=PushButtonWidget]
	{
		tooltip_name = "Paw's Patch"
		tooltip = "#paws_gold_sound_tooltip"
		set_sound = paws_gold_button_select
		unset_sound = NULL
		[View Template=GroupVE]
		{
			L = 44r
			T = 251.333333b
			R = 4r
			B = 198b
			[Child Template=DecalVE]
			when = UNFOCUSED + UNPRESSED
			texture = /UI/%s/Game/SharedTextures/ActionButtonBorderUnpressed.png
			[Child Template=DecalVE]
			when = FOCUSED + UNPRESSED
			texture = /UI/%s/Game/SharedTextures/ActionButtonBorderPressed.png
			[Child Template=DecalVE]
			when = PRESSED
			texture = /UI/%s/Game/SharedTextures/ActionButtonBorderPressed.png
			[Child Template=DecalVE]
			{
				L = 1
				T = 1.333333
				R = 39
				B = 52
				texture = /UI/Game/PawGoldSound.png
			}
		}
	}
